<?xml version="1.0" encoding="UTF-8"?>

<!-- MatterTone II default layout: "laboratory instrument, not SaaS panel".
     Molten-copper accent on graphite warm-black; the fCWT scalogram is the hero;
     controls form the instrument fascia below it, on two pages. Stealth-beta: no
     title text, identity = sigil + accent + BETA tag. Editable in-plugin via the
     WYSIWYG palette.

     Mode-dependent visibility comes from magicState properties published by
     MatterToneProcessor::handleAsyncUpdate: showModal / showPerc follow the
     engine, and the view:* properties pick which of a time's three controls is
     on screen (the 0..1 knob, an absolute time, or a beat division).

     Sizing rules (foleys gives every item margin=5 padding=5 and a dark grey
     background unless told otherwise, so the Types below reset all three):
       - fixed strips are pinned with height / width + flex-grow 0; the hero
         takes the rest;
       - no min-width / min-height on flexible items: JUCE's flex layout uses
         them as the starting size before flex-grow is shared out;
       - knobs sit in rows, two rows to a page;
       - class="swap" holds alternatives of which one is visible at a time
         (hidden items take no space);
       - class="knobgap" leaves the strip a chip would take, so a knob without
         chips is the same size as its neighbour with them. -->
<magic>
  <Styles>
    <Style name="default">
      <Nodes/>
      <Classes>
        <col margin="3" padding="6" border="0" radius="8" background-color="FF221A11"
             flex-direction="row" caption-size="13" caption-color="FFB5A895"
             caption-placement="centred-top"/>
        <hero margin="3" padding="0" border="0" radius="6" background-color="FF100C06"/>
        <page flex-direction="column" background-color="FF171209"/>
        <row flex-direction="row"/>
        <stack flex-direction="column"/>
        <centred flex-direction="column" flex-justify-content="center"/>
        <swap flex-direction="column" flex-justify-content="center"/>
        <chips flex-direction="row" flex-justify-content="center" height="22" flex-grow="0"/>
        <chip width="54" max-width="54" height="20" max-height="20" margin="1 2"
              flex-align-self="center"/>
        <knobgap padding="0 0 22 0"/>
        <beta background-color="FF80491F" radius="4" label-text="FFF4EDE3" justification="centred"
              margin="10 4" padding="0" border="0" font-size="13"/>
      </Classes>
      <Types>
        <View border="0" margin="0" padding="0" background-color="00000000"/>
        <Slider border="0" margin="0" padding="0" background-color="00000000"
                slider-type="rotary-horizontal-vertical" slider-textbox="textbox-below"
                lookAndFeel="LnfV2" rotary-fill="FFE0813E"
                caption-size="12" caption-color="FFB5A895" caption-placement="centred-top"/>
        <ComboBox border="0" margin="2" padding="0" background-color="00000000" lookAndFeel="LnfV2"
                  caption-size="11" caption-color="FFB5A895" caption-placement="centred-top"
                  max-height="42"/>
        <ToggleButton border="0" margin="2" padding="0" background-color="00000000"
                      caption-size="0" lookAndFeel="LnfV2" text-color="FFF4EDE3"/>
        <TextButton border="0" margin="2" padding="0" background-color="00000000"
                    caption-size="0" lookAndFeel="LnfV2"/>
        <Label border="0" margin="0" padding="0" background-color="00000000"/>
        <Meter border="0" margin="4 2" padding="0" background-color="00000000"
               bar-background-color="FF100C06" bar-fill-color="FFE0813E"
               outline-color="FF3D3122" tickmark-color="FFB5A895"/>
        <Plot border="0" margin="0" padding="0" background-color="00000000"
              plot-color="FFE0813E" plot-fill-color="30E0813E"/>
        <Sigil border="0" margin="2" padding="0" background-color="00000000"/>
        <PresetMenu border="0" margin="6 4" padding="0" background-color="00000000" lookAndFeel="LnfV2"/>
        <Scalogram border="0" margin="0" padding="0" background-color="00000000"/>
        <Keyboard border="0" margin="2" padding="0" background-color="00000000"/>
      </Types>
      <Palettes>
        <default/>
      </Palettes>
    </Style>
  </Styles>

  <View id="root" resizable="1" resize-corner="1" width="1240" height="860"
        min-width="1100" min-height="760" flex-direction="column" padding="6"
        margin="0" border="0" background-color="FF171209" lookAndFeel="LnfV2">

    <!-- ── header: sigil · engine and seed · presets · BETA · output meter ── -->
    <View height="46" flex-grow="0" flex-direction="row">
      <Sigil width="50" max-width="50" tooltip="Nonlinear-physics instrument (beta build)"/>
      <ComboBox parameter="engine" caption="engine" width="150" max-width="150"
                tooltip="Physical model per voice: coupled nonlinear modal resonators, or the percussion membrane (Berger tension + Helmholtz cavity + snare wires)"/>
      <ComboBox parameter="seedMode" caption="seed policy" width="170" max-width="170"
                tooltip="Fixed: one global seed. Per-Key: each key has its own reproducible character. Random on Strike: fresh seed every hit"/>
      <Slider parameter="seed" caption="seed" caption-placement="centred-left" caption-size="14"
              slider-type="linear-horizontal" slider-textbox="textbox-right"
              width="250" max-width="250" margin="0 8"
              tooltip="Deterministic material seed: same seed, same sound"/>
      <View/>
      <PresetMenu width="104" max-width="104"
                  tooltip="Save and load user presets (~/Music/MatterTone II/Presets)"/>
      <Label class="beta" text="BETA" width="62" max-width="62"/>
      <Meter source="output" width="64" max-width="64" tooltip="Output level"/>
    </View>

    <!-- ── hero: live fCWT scalogram of the output ───────────────────────── -->
    <View class="hero">
      <Scalogram tooltip="Live wavelet scalogram (fCWT) of the output"/>
    </View>

    <!-- ── fascia: two pages ─────────────────────────────────────────────── -->
    <View display="tabbed" height="330" flex-grow="0" tab-height="26" margin="3 0 0 0">

      <!-- page 1: what the instrument is made of and how it is struck -->
      <View class="page" tab-caption="instrument" tab-color="FF221A11">

        <View class="row">
          <View class="col" caption="material" flex-grow="2">
            <Slider parameter="tension" caption="tension" tooltip="Baseline stiffness: head or string tuning"/>
            <Slider parameter="damping" caption="damping" tooltip="Linear modal damping"/>
          </View>
          <View class="col" caption="nonlinearity" flex-grow="6" visibility="showModal">
            <Slider parameter="nonlinStiffness" caption="stiffness" tooltip="Cubic and quintic stiffness magnitude"/>
            <Slider parameter="hardening" caption="harden" tooltip="Softening (negative) to hardening (positive) spring"/>
            <Slider parameter="nonlinDamping" caption="damping" tooltip="Velocity-dependent damping, |v| times v"/>
            <Slider parameter="coupling" caption="coupling" tooltip="Energy transfer between modes"/>
            <Slider parameter="memory" caption="memory" tooltip="Depth of the bounded material-state memory"/>
            <Slider parameter="healing" caption="healing" tooltip="How fast the material state recovers"/>
          </View>
          <View class="col" caption="percussion" flex-grow="8" visibility="showPerc">
            <Slider parameter="membraneModes" caption="modes" tooltip="Number of membrane modes"/>
            <Slider parameter="bergerAmount" caption="berger" tooltip="Tension nonlinearity: the pitch-glide thump"/>
            <Slider parameter="cavityAmount" caption="cavity" tooltip="Helmholtz cavity coupling"/>
            <Slider parameter="cavityTune" caption="cav tune" tooltip="Cavity resonance relative to the fundamental"/>
            <Slider parameter="cavityLoss" caption="cav loss" tooltip="Orifice drag on the cavity mode"/>
            <Slider parameter="wireAmount" caption="wires" tooltip="How far the snare-wire contact bank is engaged"/>
            <Slider parameter="dampTilt" caption="damp tilt" tooltip="Extra damping on the high modes"/>
            <Slider parameter="malletHardness" caption="mallet" tooltip="Stiffness of the mallet's contact"/>
          </View>
          <View class="col" caption="contact" flex-grow="3">
            <Slider parameter="adhesion" caption="adhesion" tooltip="How strongly touching surfaces stick before they let go"/>
            <Slider parameter="contactHardness" caption="hardness" tooltip="Stiffness of the contact"/>
            <Slider parameter="contactLoss" caption="loss" tooltip="Energy lost in each contact"/>
          </View>
        </View>

        <View class="row">
          <View class="col" caption="excitation" flex-grow="6.7">
            <View class="centred" flex-grow="1.5" visibility="showModal">
              <ComboBox parameter="excitation" caption="mode" height="42" flex-grow="0"
                        tooltip="Pluck: energy is injected at once. Load / Snap: slow loading, then release"/>
            </View>
            <View class="stack" flex-grow="1.7">
              <View class="swap">
                <Slider parameter="attack" caption="attack" visibility="view:attackKnob"
                        tooltip="Onset ramp (de-click)"/>
                <Slider parameter="attackMs" caption="attack" visibility="view:attackMs"
                        tooltip="Attack time in milliseconds"/>
                <ComboBox parameter="attackDiv" caption="attack" visibility="view:attackDiv"
                          height="42" flex-grow="0" tooltip="Attack time as a beat division of the host tempo"/>
              </View>
              <View class="chips">
                <ToggleButton parameter="attackOvr" text="timed" class="chip"
                              tooltip="Set the attack as an absolute time instead of the 0 to 1 knob"/>
                <ToggleButton parameter="attackSync" text="beats" class="chip" visibility="view:attackTimed"
                              tooltip="The attack time follows the host tempo"/>
              </View>
            </View>
            <Slider parameter="pluckEnergy" caption="energy" class="knobgap" tooltip="Injected strike or pluck energy"/>
            <Slider parameter="strikePosition" caption="position" class="knobgap" tooltip="Strike position: the balance between modes"/>
            <Slider parameter="velocitySens" caption="velocity" class="knobgap" tooltip="How much MIDI velocity changes the energy"/>
            <Slider parameter="agitation" caption="agitation" class="knobgap" tooltip="Continuous random forcing that keeps the material moving"/>
          </View>

          <View class="col" caption="events" flex-grow="5.7" visibility="showModal">
            <Slider parameter="brittleness" caption="brittle" class="knobgap" tooltip="Sharpness of the snap and crackle barrier"/>
            <Slider parameter="roughness" caption="rough" class="knobgap" tooltip="Heterogeneity of the crackle network"/>
            <Slider parameter="crackleCoupling" caption="crackle" class="knobgap" tooltip="Coupling of the pop-cascade network"/>
            <Slider parameter="snapDepth" caption="snap" class="knobgap" tooltip="Depth of the bistable well"/>
            <View class="stack" flex-grow="1.7">
              <View class="swap">
                <Slider parameter="loadingRate" caption="load" visibility="view:loadKnob"
                        tooltip="Rate of the snap-loading ramp"/>
                <Slider parameter="loadMs" caption="load" visibility="view:loadMs"
                        tooltip="Loading time in milliseconds"/>
                <ComboBox parameter="loadDiv" caption="load" visibility="view:loadDiv"
                          height="42" flex-grow="0" tooltip="Loading time as a beat division of the host tempo"/>
              </View>
              <View class="chips">
                <ToggleButton parameter="loadOvr" text="timed" class="chip"
                              tooltip="Set the loading as an absolute time instead of the 0 to 1 knob"/>
                <ToggleButton parameter="loadSync" text="beats" class="chip" visibility="view:loadTimed"
                              tooltip="The loading time follows the host tempo"/>
              </View>
            </View>
          </View>

          <View class="col" caption="output" flex-grow="6.5">
            <Slider parameter="eventMix" caption="events" class="knobgap" tooltip="Weight of contact, snap and crackle in the output"/>
            <Slider parameter="bodyMix" caption="body" class="knobgap" tooltip="Blend of the body filter"/>
            <Slider parameter="agc" caption="attack AGC" class="knobgap" tooltip="Per-voice automatic gain, so an attack never hits the limiter"/>
            <Slider parameter="output" caption="level" class="knobgap" tooltip="Output gain"/>
            <Slider parameter="numVoices" caption="voices" class="knobgap" tooltip="Maximum simultaneous notes (polyphony)"/>
            <View class="centred" flex-grow="1.5">
              <ComboBox parameter="oversampling" caption="oversampling" height="42" flex-grow="0"
                        tooltip="Oversampling of the integrator"/>
            </View>
          </View>
        </View>
      </View>

      <!-- page 2: what moves it, and how it is tuned -->
      <View class="page" tab-caption="motion + tuning" tab-color="FF221A11">

        <View class="row">
          <View class="col" caption="LFO A">
            <View class="centred" flex-grow="1.6">
              <ComboBox parameter="lfoAShape" caption="shape" height="42" flex-grow="0" tooltip="LFO A waveform"/>
              <ComboBox parameter="lfoARetrig" caption="retrigger" height="42" flex-grow="0"
                        tooltip="Free-running, retriggered by each key, or locked to the transport"/>
            </View>
            <View class="stack">
              <View class="swap">
                <Slider parameter="lfoARateHz" caption="rate" visibility="view:lfoAHz" tooltip="LFO A rate in Hz"/>
                <ComboBox parameter="lfoADiv" caption="rate" visibility="view:lfoADiv" height="42" flex-grow="0"
                          tooltip="LFO A cycle as a beat division of the host tempo"/>
              </View>
              <View class="chips">
                <ToggleButton parameter="lfoASync" text="beats" class="chip" tooltip="LFO A rate follows the host tempo"/>
              </View>
            </View>
            <View class="stack">
              <Slider parameter="lfoAPhase" caption="phase" tooltip="Phase offset of LFO A"/>
              <View class="chips">
                <ToggleButton parameter="lfoABipolar" text="bipolar" class="chip"
                              tooltip="Bipolar swings around the knob value; unipolar only adds"/>
              </View>
            </View>
            <Slider parameter="driveModA" caption="to drive" class="knobgap" tooltip="LFO A depth on the strike energy"/>
            <Slider parameter="dampModA" caption="to damping" class="knobgap" tooltip="LFO A depth on the damping"/>
            <Slider parameter="coupModA" caption="to coupling" class="knobgap" tooltip="LFO A depth on the coupling"/>
            <Slider parameter="crackleModA" caption="to crackle" class="knobgap" tooltip="LFO A depth on the crackle coupling"/>
          </View>

          <View class="col" caption="LFO B">
            <View class="centred" flex-grow="1.6">
              <ComboBox parameter="lfoBShape" caption="shape" height="42" flex-grow="0" tooltip="LFO B waveform"/>
              <ComboBox parameter="lfoBRetrig" caption="retrigger" height="42" flex-grow="0"
                        tooltip="Free-running, retriggered by each key, or locked to the transport"/>
            </View>
            <View class="stack">
              <View class="swap">
                <Slider parameter="lfoBRateHz" caption="rate" visibility="view:lfoBHz" tooltip="LFO B rate in Hz"/>
                <ComboBox parameter="lfoBDiv" caption="rate" visibility="view:lfoBDiv" height="42" flex-grow="0"
                          tooltip="LFO B cycle as a beat division of the host tempo"/>
              </View>
              <View class="chips">
                <ToggleButton parameter="lfoBSync" text="beats" class="chip" tooltip="LFO B rate follows the host tempo"/>
              </View>
            </View>
            <View class="stack">
              <Slider parameter="lfoBPhase" caption="phase" tooltip="Phase offset of LFO B"/>
              <View class="chips">
                <ToggleButton parameter="lfoBBipolar" text="bipolar" class="chip"
                              tooltip="Bipolar swings around the knob value; unipolar only adds"/>
              </View>
            </View>
            <Slider parameter="driveModB" caption="to drive" class="knobgap" tooltip="LFO B depth on the strike energy"/>
            <Slider parameter="dampModB" caption="to damping" class="knobgap" tooltip="LFO B depth on the damping"/>
            <Slider parameter="coupModB" caption="to coupling" class="knobgap" tooltip="LFO B depth on the coupling"/>
            <Slider parameter="crackleModB" caption="to crackle" class="knobgap" tooltip="LFO B depth on the crackle coupling"/>
          </View>
        </View>

        <View class="row">
          <View class="col" caption="tuning">
            <View class="centred" flex-grow="1.6">
              <ComboBox parameter="tuningMode" caption="scale" height="42" flex-grow="0"
                        tooltip="Chromatic keys, a set of ratios, or a scale taken from an attractor"/>
            </View>
            <Slider parameter="rootNote" caption="root note" tooltip="MIDI note the scale is built on"/>
            <Slider parameter="modeRatio" caption="mode ratio" tooltip="Frequency ratio between neighbouring modes"/>
            <Slider parameter="attractorSet" caption="attractor set" tooltip="Which attractor the scale is taken from"/>
            <Slider parameter="scaleSpread" caption="spread" tooltip="Stretches or squeezes the scale"/>
            <Slider parameter="energyToPitch" caption="energy to pitch" tooltip="How much the stored energy bends the pitch"/>
            <Slider parameter="stabilityBias" caption="stability" tooltip="Bias toward the stable notes of the scale"/>
            <View flex-grow="3"/>
          </View>
        </View>
      </View>

    </View>

    <!-- ── keyboard ──────────────────────────────────────────────────────── -->
    <Keyboard height="64" flex-grow="0"
                       key-down-color="FFE0813E" mouse-over-color="50E0813E"/>
  </View>
</magic>
